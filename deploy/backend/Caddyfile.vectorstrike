# Reverse proxy + automatic HTTPS (Let's Encrypt) for bfdb, run on the SAME
# Windows machine as the DCS server / bfdb.exe. Caddy handles TLS termination
# so bfdb itself can keep listening on plain HTTP on localhost only.
#
# Requires: api.vectorstrike.org's DNS A record pointing at this machine's
# public IP, and ports 80 + 443 open/forwarded to it (80 is needed for the
# one-time ACME challenge, even though all real traffic ends up on 443).
#
# Install Caddy on Windows: https://caddyserver.com/docs/install#windows
# Run:  caddy run --config deploy/backend/Caddyfile.vectorstrike
# (or install as a Windows service so it survives reboots: NSSM, or
#  `caddy windows-service` via the caddy-windows-service adapter)
#
# Behind a CDN (e.g. Cloudflare proxying api.vectorstrike.org): Caddy then
# sees the CDN's edge address, not the visitor's, and overwrites
# X-Forwarded-For with it -- so bfdb's per-IP limits lump every visitor
# together. To fix that, trust the CDN's ranges in BOTH places:
#
#   1. Here, in a global options block at the top of this file:
#
#        {
#            servers {
#                # Cloudflare's published ranges: https://www.cloudflare.com/ips/
#                trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
#            }
#        }
#
#   2. On bfdb: one --trusted-proxy <cidr> per range above, plus
#      --trust-cf-connecting-ip to read Cloudflare's CF-Connecting-IP.
#
# Not enabled: without a CDN in front, trusting ranges you do not sit behind
# lets anyone in them claim any address.

api.vectorstrike.org {
	reverse_proxy 127.0.0.1:8880

	# WebSocket upgrade (logs, engine logs, live units) is handled
	# automatically by reverse_proxy — no extra config needed.

	encode gzip

	# Security headers. bfdb sets nosniff / frame / referrer / CSP on its own
	# responses; HSTS belongs here, where TLS is. (`?` = only if bfdb did not
	# already set that header.)
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		?X-Content-Type-Options "nosniff"
		?X-Frame-Options "DENY"
		?Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# No `log` directive on purpose: an access log here would record the
	# `?token=` that /api/logs/* and /api/metrics accept. If you add one, add
	#   format filter { request>uri query { delete token } }
	# to it.
}
