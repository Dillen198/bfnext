-- Options -> Special -> Vector Strike. Widgets are bound to the settings in
-- optionsDb.lua by name: <setting><Control>, e.g. toggleKeyComboList.

local left   = 56
local labelW = 210
local ctrlX  = 282
local ctrlW  = 225
local rowH   = 25

local TitleSkin    = { ["params"] = { ["name"] = "staticOptionsTitleSkin" },
	["states"] = { ["released"] = { [1] = { ["text"] = { ["horzAlign"] = { ["type"] = "min" } } } } } }
local LabelSkin    = { ["params"] = { ["name"] = "staticOptionsCaptionSkin" } }
local CheckBoxSkin = { ["params"] = { ["name"] = "checkBoxSkin_options" } }
local ComboSkin    = { ["params"] = { ["name"] = "comboListSkin_options" } }
local HelpSkin     = { ["params"] = { ["name"] = "staticSkin2" },
	["states"] = { ["released"] = { [1] = { ["text"] = { ["fontSize"] = 10, ["horzAlign"] = { ["type"] = "min" } } } } } }

local function static(text, x, y, w, h, skin)
	return {
		["params"] = {
			["bounds"] = { ["x"] = x, ["y"] = y, ["w"] = w, ["h"] = h },
			["enabled"] = true, ["text"] = text, ["tooltip"] = "", ["visible"] = true, ["zindex"] = 0,
		},
		["skin"] = skin,
		["type"] = "Static",
	}
end

local function checkbox(text, x, y, w)
	return {
		["params"] = {
			["bounds"] = { ["x"] = x, ["y"] = y, ["w"] = w, ["h"] = 20 },
			["enabled"] = true, ["state"] = false, ["text"] = text, ["tooltip"] = "",
			["visible"] = true, ["zindex"] = 0, ["tabOrder"] = 0,
		},
		["skin"] = CheckBoxSkin,
		["type"] = "CheckBox",
	}
end

local function combo(x, y)
	return {
		["params"] = {
			["bounds"] = { ["x"] = x, ["y"] = y, ["w"] = ctrlW, ["h"] = rowH },
			["enabled"] = true, ["tabOrder"] = 0, ["text"] = "Item1", ["tooltip"] = "",
			["visible"] = true, ["zindex"] = 0,
		},
		["skin"] = ComboSkin,
		["type"] = "ComboList",
	}
end

-- The Vector Strike logo, from this plugin's own Theme folder.
--
-- DCS runs a .dlg in an EMPTY environment (dxgui/loader/DialogLoader.lua:
-- setfenv(f, {})) -- no lfs, no pcall, no globals at all -- so this file
-- cannot find its own folder, and calling any global would stop the whole
-- page from loading. The installer, which knows the profile path, rewrites the
-- next line with the logo's absolute path. Copied by hand, it stays nil and
-- the page simply has no logo.
local logoFile = nil -- BFCOCKPIT_LOGO_PATH

local function logo(x, y, w, h)
	local released = { ["text"] = { ["horzAlign"] = { ["type"] = "min" } } }
	if logoFile then
		released["picture"] = {
			["file"] = logoFile,
			["color"] = "0xffffffff",
			["horzAlign"] = { ["type"] = "middle", ["offset"] = 0 },
			["vertAlign"] = { ["type"] = "middle", ["offset"] = 0 },
			["size"] = { ["horz"] = w, ["vert"] = h },
			["userTexSampler"] = 0,
		}
	end
	return {
		["params"] = {
			["bounds"] = { ["x"] = x, ["y"] = y, ["w"] = w, ["h"] = h },
			["enabled"] = true, ["text"] = "", ["tooltip"] = "", ["visible"] = true, ["zindex"] = 0,
		},
		["skin"] = { ["params"] = { ["name"] = "staticSkin2" }, ["states"] = { ["released"] = { [1] = released } } },
		["type"] = "Static",
	}
end

