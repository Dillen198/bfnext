# Copy to .env.local and edit. All are read at BUILD time (Vite inlines them).

# bfdb base URL, no trailing slash. Unset (the default in development) the
# site calls a same-origin /api, which the dev server proxies to VITE_BFDB_URL.
# .env.production sets https://api.vectorstrike.org for builds.
# VITE_API_BASE=http://localhost:8880

# Which bfdb instance serves the range. Leave unset and bfdb picks its range
# instance itself; set it only when one bfdb fronts several range servers.
# VITE_RANGE_INSTANCE=range

# Dev proxy target for /api when VITE_API_BASE is unset (`--mode live` uses production).
# VITE_BFDB_URL=http://localhost:8880

# The dashboard, whose flight replay (web Tacview) the debrief opens.
# Default: https://dashboard.vectorstrike.org
# VITE_DASHBOARD_URL=https://dashboard.vectorstrike.org

# 1 = serve everything from src/mock/ fixtures (same as `npm run dev:mock`).
# VITE_MOCK=1
