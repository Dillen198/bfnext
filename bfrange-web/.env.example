# Copy to .env.local and edit. All are read at BUILD time (Vite inlines them).

# bfdb base URL, no trailing slash. Default: https://api.vectorstrike.org
# Set it empty (VITE_API_BASE=) to call a same-origin /api and use the dev
# proxy below instead.
# VITE_API_BASE=https://api.vectorstrike.org

# Which bfdb instance serves the range. Leave unset and bfdb picks its range
# instance itself; set it only when one bfdb fronts several range servers.
# VITE_RANGE_INSTANCE=range

# Dev proxy target for /api when VITE_API_BASE is empty.
# VITE_BFDB_URL=http://localhost:8880

# 1 = serve everything from src/mock/ fixtures (same as `npm run dev:mock`).
# VITE_MOCK=1
